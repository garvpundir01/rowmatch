{
  "name": "rowmatch",
  "version": "1.0.0",
  "private": true,
  "description": "A text-to-SQL agent with schema linking and execution-feedback self-correction, plus the execution-based harness that measures it.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "rowmatch": "bin/rowmatch.js",
    "rowmatch-agent": "bin/agent.js"
  },
  "scripts": {
    "test": "node --test",
    "bench": "node bin/rowmatch.js",
    "bench:json": "node bin/rowmatch.js --json",
    "agent": "node bin/agent.js --provider mock",
    "agent:ablate": "node bin/agent.js --provider mock --ablate"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.70.0"
  }
}
